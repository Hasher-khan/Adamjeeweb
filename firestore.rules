rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Public site + admin CMS share these documents.
    // Admin currently signs in with the CMS password, not Firebase Auth,
    // so client writes must be allowed here for the live site to work.
    match /cms/{docId} {
      allow read, write: if true;
    }

    match /studentApplications/{applicationId} {
      allow create: if request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() < 200
        && request.resource.data.status == 'Pending';
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /students/{userId} {
      allow read, create, update: if owns(userId);
      allow delete: if false;

      match /private/{documentId} {
        allow read, write: if owns(userId);
      }
    }

    match /applicationRecords/{applicationId} {
      allow read, write: if false;
    }
  }
}
