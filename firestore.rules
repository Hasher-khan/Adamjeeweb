rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // A student may access only the documents inside their own UID path.
    match /students/{userId} {
      allow read, create, update: if owns(userId);
      allow delete: if false;

      match /private/{documentId} {
        allow read, write: if owns(userId);
      }
    }

    // Reserved for a trusted server/Admin SDK. Clients cannot list all records.
    match /applicationRecords/{applicationId} {
      allow read: if admin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
