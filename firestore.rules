rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── CMS content (faculty, admissions, timetable, settings) ────────────────
    // Public pages can read CMS data without logging in.
    // Admin panel can write CMS data (protected by the login page in the browser).
    match /cms/{document} {
      allow read: if true;
      allow write: if true;
    }

    // ── Student applications ───────────────────────────────────────────────────
    // Anyone can submit an application (public admissions form).
    // Admin panel can read and update application status.
    match /studentApplications/{applicationId} {
      allow read, write: if true;
    }

    // ── Student private data (Firebase Auth required) ─────────────────────────
    // A student may access only documents inside their own UID path.
    match /students/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /private/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Block everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
